# NutriAI Environment Configuration Example
# Copy this file to .env and insert your real production credentials

# Server Port
PORT=8080

# Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Authorized JavaScript Origins: http://localhost:8080, http://127.0.0.1:8080
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Google Gemini AI API Key (from Google AI Studio: https://aistudio.google.com/)
# Used securely by the backend for AI Food Vision Scanning & Conversational Coaching
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Email Service for Real 2FA Outbound Dispatch (Nodemailer / SMTP / SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="NutriAI Security <security@nutriai.app>"
